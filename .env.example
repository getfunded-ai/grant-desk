# Copy to .env.local for local work. Never commit .env.local. Zach pastes real values into Vercel.
# Phase C: Supabase (docs/DEPLOY.md). The two NEXT_PUBLIC values are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Creates organizations and sends invites. Zach pastes it into Vercel.
SUPABASE_SECRET_KEY=
# Phase C: error tracking. "vercel" writes server errors to the Vercel logs; empty turns it off.
ERROR_TRACKING=
# Phase C / E: email
RESEND_API_KEY=
EMAIL_FROM=
# Phase D / N: government data (optional keys)
SIMPLER_GRANTS_API_KEY=
SAM_GOV_API_KEY=
# Phase I: billing (one of the two paths)
DAS_URL=
DAS_APP_ID=
DAS_SERVER_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Phase J: analytics
NEXT_PUBLIC_POSTHOG_KEY=
# Phase K: AI (server only; users may bring their own key in settings)
ANTHROPIC_API_KEY=
